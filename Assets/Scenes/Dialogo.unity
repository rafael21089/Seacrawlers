--- !u!114 &266991978
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 266991975}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 64d20703c688ca34f93bfa0d8382353f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  message:
  - actorId: 0
    message: "What do you want maggot?! Shouldn\xB4t you be cleaning the deck?"
  - actorId: 0
    message: "I haven\xB4t seen you here before, you must be new here , well new
      maggots go do maggot work, so off you go!"
  - actorId: 1
    message: "I\xB4m here for the trials."
  - actorId: 0
    message: HAHAHAHAHAHA!!!
  - actorId: 0
    message: no.
  - actorId: 0
    message: "You can\xB4t be serious. A maggot like you could never be more than
      a standing lookout "
  - actorId: 0
    message: "But fine, if you desire to end your miserable life I won\xB4t stop
      you, I would do the same in your postion"
  - actorId: 0
    message: There are some pirates on those islands that have been steaqling from
      us, for your first trial you will need to kill them and then return to me.
  - actorId: 0
    message: Goodbye maggot.
  actors:
  - name: Lady Captain
    sprite: {fileID: 21300000, guid: e6b27bf420882054e890dcc5e2d2473d, type: 3}
  - name: Player
    sprite: {fileID: 21300000, guid: 2c6059bece9b90b48bcd741bbeac4168, type: 3}
