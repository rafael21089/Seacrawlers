  m_Name: 
  m_EditorClassIdentifier: 
  message:
  - actorId: 0
    message: 'You want to truly show your valor? '
  - actorId: 1
    message: What do you have for me?
  - actorId: 0
    message: A terrible beast in the Vulcanic Wastelands, no one has been able to
      defeat it, not even me or my comrades
  - actorId: 0
    message: "I seek blood for what happened on that voyage, and I\xB4ll pay good
      coin for it I assure you"
  - actorId: 0
    message: Are you up to the task?
  actors:
  - name: Salvador
    sprite: {fileID: 21300000, guid: f84b65d1ad073ed4aa7fc3d8d8d50628, type: 3}
  - name: You
    sprite: {fileID: 21300000, guid: 2c6059bece9b90b48bcd741bbeac4168, type: 3}
