  message:
  - actorId: 0
    message: Hello Sir! Would you care to give a hand?
  - actorId: 0
    message: "I haven\xB4t eaten in a few days and my legs are no good no more"
  - actorId: 0
    message: Would you care to collect some wheat for me to eat?
  - actorId: 1
    message: Sure
  - actorId: 0
    message: 'Thank you so much '
